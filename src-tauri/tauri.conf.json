{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Dictation",
  "version": "0.1.1",
  "identifier": "com.samiulshadman.voicedictation",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1520",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Dictation",
        "width": 880,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/voice-dictation/libsherpa-onnx-c-api.so": "target/release/deps/libsherpa-onnx-c-api.so",
          "/usr/lib/voice-dictation/libonnxruntime.so": "target/release/deps/libonnxruntime.so"
        }
      }
    }
  }
}
