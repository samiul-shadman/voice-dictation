{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "local-audio-transcription-tool-v2",
  "version": "0.1.0",
  "identifier": "com.samiul.local-audio-transcription-tool-v2",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Dictation",
        "width": 880,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
